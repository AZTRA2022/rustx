{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "autoCloseBefore": ";:.,=}])>` \n\t",
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\{[^}\"']*|\\([^)\"']*|<[A-Za-z_][^>]*[^/]>[^<]*)$",
    "decreaseIndentPattern": "^\\s*(\\}|\\)|</[A-Za-z_][^>]*>)"
  }
}
