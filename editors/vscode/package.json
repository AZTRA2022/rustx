{
  "name": "rustx",
  "displayName": "rustx",
  "description": "What an editor needs to know about a .rsx: its colours, its pairs, and where the mistakes are.",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rsx",
        "aliases": [
          "rustx",
          "rsx"
        ],
        "extensions": [
          ".rsx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rsx",
        "scopeName": "source.rsx",
        "path": "./syntaxes/rsx.tmLanguage.json",
        "embeddedLanguages": {
          "source.rust": "rust"
        }
      }
    ],
    "configuration": {
      "title": "rustx",
      "properties": {
        "rustx.server.path": {
          "type": "string",
          "default": "",
          "description": "Where `rustx-lsp` is. Empty means: on the PATH."
        },
        "rustx.rustAnalyzer.path": {
          "type": "string",
          "default": "",
          "description": "Where rust-analyzer is, when it is not on the PATH. Completion, hovers and go-to-definition come from it; leave empty to use the PATH."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs --release",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "9.0.0",
    "@types/node": "22.10.2",
    "@types/vscode": "1.90.0",
    "esbuild": "0.24.2",
    "typescript": "5.7.2"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:rsx"
  ],
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
