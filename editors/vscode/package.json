{
  "name": "rustx",
  "displayName": "rustx",
  "description": "What an editor needs to know about a .rsx: its colours, its pairs, and where the mistakes are.",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rsx",
        "aliases": [
          "rustx",
          "rsx"
        ],
        "extensions": [
          ".rsx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rsx",
        "scopeName": "source.rsx",
        "path": "./syntaxes/rsx.tmLanguage.json",
        "embeddedLanguages": {
          "source.rust": "rust"
        }
      }
    ]
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "9.0.0"
  }
}
